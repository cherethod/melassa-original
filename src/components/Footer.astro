<style>
  footer {
    background: var(--color-melassa-blue);
    background: radial-gradient(
      circle at 100% 90%,
      rgba(184, 236, 255, 1) 0%,
      rgba(0, 173, 239, 1) 100%
    );
    & > div > div {
      border-width: 0 1px 1px 0;
      border-color: rgba(255, 255, 255, 0.2);
      border-style: solid;
      padding-right: 1rem;

      h3 {
        font-size: 1.25rem;
        font-weight: 800;
        font-family: var(--font-family-body);
        position: relative;
        z-index: 1;
        width: fit-content;
        text-shadow: 1px 1px 1px rgba(0, 0, 0, 1);
        &::after {
          content: "";
          display: block;
          position: absolute;
          bottom: -2px;
          left: -4px;
          width: 110%;
          height: 16px;
          background-color: var(--color-melassa-pink);
          z-index: -1;
          border-radius: 2px;
        }
      }
    }
    & > div > div:last-child {
      border-right: none;
    }
    a,
    p,
    h3 {
      font-family: var(--font-family-body);
    }
  }
</style>
