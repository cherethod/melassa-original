---
const { imageSrc, imageAlt, rotationDeegres } = Astro.props;
---

<div class="card-container flex items-center justify-center">
  <div
    class="product-card w-60 h-60 p-6 bg-yellow-50 rounded shadow-xl shadow-black"
  >
    <img
      src={`./${imageSrc}`}
      alt={imageAlt}
      class="object-cover w-full h-full border"
    />
  </div>
</div>

<style define:vars={{ rotation: rotationDeegres }}>
  .product-card {
    transform: rotate(calc(var(--rotation) * 1deg));
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-container {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-container:hover .product-card {
    transform: rotate(0deg) scale(1.1);
  }

  .card-container:hover {
    transform: scale(1.1);
  }
</style>
